# From https://build.nvidia.com — key prefix nvapi-
NVIDIA_API_KEY=

# Optional override (default: nvidia/nemotron-3-nano-30b-a3b)
# Inlined at Next.js build time — changing this on Vercel requires a redeploy.
# Do not set deepseek-ai/deepseek-v4-flash — that ID is retired (HTTP 410 Gone).
NVIDIA_MODEL=
